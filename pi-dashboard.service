[Unit]
Description=Raspberry Pi status dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Homelab-website
ExecStart=/usr/bin/python3 /home/pi/Homelab-website/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
